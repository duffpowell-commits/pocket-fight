; Engine configuration file.
; Wildmade (repo pocket-fight). Everything else (package name, APK
; name, updater URL) is filled in by CI from the GitHub repo name.

config_version=5

[application]

config/name="Wildmade"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

general/ios/mix_with_others=true

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Controls="*res://scripts/controls.gd"
Settings="*res://scripts/settings.gd"
Save="*res://scripts/save_game.gd"
Audio="*res://scripts/audio.gd"
Subs="*res://scripts/subs.gd"
Feel="*res://scripts/feel.gd"
Telemetry="*res://scripts/telemetry.gd"
Loader="*res://scripts/loader.gd"
Battery="*res://scripts/battery.gd"
Updater="*res://scripts/updater.gd"
DebugMenu="*res://scripts/debug_menu.gd"
Autoplay="*res://scripts/autoplay.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[application.config]

quit_on_go_back=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
